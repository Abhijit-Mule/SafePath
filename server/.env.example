PORT=5000
# MongoDB Atlas connection string. Replace <db_password> locally; never commit real credentials.
MONGO_URI=mongodb+srv://safepath-app:<db_password>@cluster0.rh9tl93.mongodb.net/safepath?retryWrites=true&w=majority&appName=Cluster0
JWT_SECRET=replace-with-a-long-random-secret
AI_SERVICE_URL=http://127.0.0.1:8000
CLIENT_ORIGIN=http://localhost:5173

# S3-compatible production image storage
S3_BUCKET=safepath-reports
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_BASE_URL=https://cdn.example.com
